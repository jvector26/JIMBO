   const nx=li.nextElementSibling, open=nx&&nx.classList.contains('skd');
   if(open){ nx.remove(); pvSkOpen.delete(c); li.classList.remove('open'); li.setAttribute('aria-expanded','false'); }
   else { li.insertAdjacentHTML('afterend',`<li class="skd" data-skd="${c}">${skDetail(c,p)}</li>`); pvSkOpen.add(c); li.classList.add('open'); li.setAttribute('aria-expanded','true'); } }
